{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{data/**,includes/**,cms/**,*.php}"
    }
  },
  "routes": [
    {
      "src": "^/data(/.*)?$",
      "status": 403
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/cms/assets/(.*)$",
      "dest": "/cms/assets/$1"
    },
    {
      "src": "^/robots.txt$",
      "dest": "/robots.txt"
    },
    {
      "src": "^/sitemap.xml$",
      "dest": "/sitemap.xml"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.php"
    }
  ]
}
