# ==============================================================================
# Vel Pharmacy College - Official Git Ignore Rules
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.stackdump

# Development Environments & IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.sublime-workspace
*.sublime-project
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates

# Temporary, Cache & Backup Files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.orig
*.rej

# Test & Debug Scratch Scripts
test_*.php
test_*.js
scratch_*.php
scratch_*.js

# Server Logs & Audit Records
*.log
error_log
php_errors.log
access_log
data/security_log.json

# Environment Secrets
.env
.env.*
!.env.example

# Package Managers (if used)
node_modules/
vendor/
composer.phar
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

